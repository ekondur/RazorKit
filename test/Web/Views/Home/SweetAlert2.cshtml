@using RazorKit
@using RazorKit.SweetAlert2.Builders
@{
    ViewData["Title"] = "SweetAlert2 examples";

    var examples = new (string Id, string Name, string Description, string Button, SwalBuilder Options)[]
    {
        ("alert", "Success message", "Open a draggable dialog and acknowledge the completed export.", "Preview export result",
            Html.Swal().Title("Export complete").Text("The sample report is ready.")
                .Icon("success").Draggable(true).ConfirmButtonText("Got it")),

        ("draft", "Save or discard", "Try each of the three ways to leave a draft.", "Leave draft",
            Html.Swal().Title("Save this draft?").Text("Choose what should happen to the sample draft.")
                .Icon("question").ShowDenyButton(true).ShowCancelButton(true)
                .ConfirmButtonText("Save draft").DenyButtonText("Discard draft").CancelButtonText("Keep editing")
                .FocusCancel(true)),

        ("name", "Validated text input", "Try a short name, then enter at least three characters.", "Rename sample project",
            Html.Swal().Title("Rename project").Input("text").InputLabel("Project name")
                .InputPlaceholder("e.g. Release dashboard").InputAttributes(a => a.Add("maxlength", "40"))
                .InputValidator("validateProjectName").ShowCancelButton(true).ConfirmButtonText("Use name")),

        ("digest", "Select a preference", "Choose how often to receive the sample digest.", "Choose frequency",
            Html.Swal().Title("Digest frequency").Input("select").InputLabel("Delivery schedule")
                .InputOptions(new { daily = "Daily", weekly = "Weekly", monthly = "Monthly" }).InputValue("weekly")
                .ShowCancelButton(true).ConfirmButtonText("Apply preference")),

        ("lookup", "Async lookup", "Try RK-101 for a match or another ID to see an error and retry.", "Find a sample issue",
            Html.Swal().Title("Find an issue").Input("text").InputLabel("Sample issue ID")
                .InputPlaceholder("RK-101").ConfirmButtonText("Look up").ShowCancelButton(true)
                .ShowLoaderOnConfirm(true).PreConfirm("lookupSampleIssue")),

        ("toast", "Timed notification", "Watch the progress bar, or hover over the toast to pause it.", "Show notification",
            Html.Swal().Title("Sample preferences saved").Icon("success").Toast(true).Position("top-end")
                .ShowConfirmButton(false).ShowCloseButton(true).Timer(3000).TimerProgressBar(true)
                .DidOpen("pauseToastOnHover"))
    };
}

<h1>@ViewData["Title"]</h1>
<p>Try a dialog, inspect the options generated by <code>Html.Swal()</code>, and see how it closed.</p>

<div class="row g-3">
    @foreach (var example in examples)
    {
        <section class="col-md-6 col-xl-4" aria-labelledby="heading-@example.Id">
            <div class="card h-100"><div class="card-body">
                <h2 id="heading-@example.Id" class="h5">@example.Name</h2>
                <p>@example.Description</p>
                <button type="button" id="run-@example.Id" class="btn btn-outline-primary">@example.Button</button>
                <p class="mt-3 mb-2 small" id="result-@example.Id" role="status">Ready to try.</p>
                <details>
                    <summary>Generated options</summary>
                    <pre class="bg-light p-2 mt-2"><code>@example.Options.Render().ToString()</code></pre>
                </details>
            </div></div>
        </section>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11"></script>
    <script>
        (() => {
            function validateProjectName(value) {
                if (value.trim().length < 3) return 'Enter at least three characters.';
            }

            async function lookupSampleIssue(value) {
                const id = value.trim().toUpperCase();
                await new Promise(resolve => setTimeout(resolve, 500));
                if (id === 'RK-101') return 'RK-101 · Improve the examples page';
                Swal.showValidationMessage('No sample issue found. Try RK-101.');
                return false;
            }

            function pauseToastOnHover(popup) {
                popup.addEventListener('mouseenter', Swal.stopTimer);
                popup.addEventListener('mouseleave', Swal.resumeTimer);
            }

            function describeResult(id, result) {
                if (result.isDenied) return 'Draft discarded.';
                if (!result.isConfirmed) {
                    if (result.dismiss === Swal.DismissReason.timer) return 'Notification closed when the timer expired.';
                    if (id === 'draft') return 'Still editing the draft.';
                    return 'Dismissed (' + result.dismiss + ').';
                }
                switch (id) {
                    case 'alert': return 'Export acknowledged.';
                    case 'draft': return 'Draft saved.';
                    case 'name': return 'Project name: ' + result.value.trim();
                    case 'digest': return 'Digest frequency: ' + result.value + '.';
                    case 'lookup': return 'Found ' + result.value + '.';
                    default: return 'Confirmed.';
                }
            }

            const options = {
                @foreach (var example in examples)
                {
                    <text>'@example.Id': @example.Options.Render(),</text>
                }
            };
            for (const [id, config] of Object.entries(options)) {
                const output = document.getElementById('result-' + id);
                document.getElementById('run-' + id).addEventListener('click', async () => {
                    if (!window.Swal) {
                        output.textContent = 'SweetAlert2 could not load. Check your connection and reload the page.';
                        return;
                    }
                    const result = await Swal.fire(config);
                    output.textContent = describeResult(id, result);
                });
            }
        })();
    </script>
}
